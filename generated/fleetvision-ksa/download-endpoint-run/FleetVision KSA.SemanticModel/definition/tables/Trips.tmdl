	column DistanceBand = SWITCH(TRUE(), 'Trips'[actual_distance_miles] >= 1000, "Long Haul", 'Trips'[actual_distance_miles] >= 500, "Medium Haul", "Short Haul")
		dataType: string
		lineageTag: b4374b2a-0eef-5fe1-817b-7637e170f0cc
