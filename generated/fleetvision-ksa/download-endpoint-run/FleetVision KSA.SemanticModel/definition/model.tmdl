model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation PBI_QueryOrder = ["Trips", "Drivers", "Trucks", "Maintenance", "Trailers", "Customers", "Loads", "Facilities", "DeliveryEvents", "Routes", "FuelPurchases", "SafetyIncidents"]
	annotation PBI_ProTooling = ["DevMode"]

ref table Trips
ref table Drivers
ref table Trucks
ref table Maintenance
ref table Trailers
ref table Customers
ref table Loads
ref table Facilities
ref table DeliveryEvents
ref table Routes
ref table FuelPurchases
ref table SafetyIncidents

ref cultureInfo en-US
