    {
      "name": "Bearer token for Qlik",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json;",
              "try {",
              "  json = pm.response.json();",
              "} catch (err) {",
              "  throw new Error('Invalid JSON response while retrieving bearer token.');",
              "}",
              "",
              "if (!json || typeof json.access_token !== 'string' || !json.access_token.trim()) {",
              "  throw new Error('Token response is missing a valid access_token field.');",
              "}",
              "",
              "pm.test('Response contains access_token', function () {",
              "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "await pm.vault.set('Bearer Token', json.access_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
