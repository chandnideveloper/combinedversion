		annotation SummarizationSetBy = Automatic

	column FuelEfficiencyBand = SWITCH(TRUE(), 'Trips'[average_mpg] >= 8, "High MPG", 'Trips'[average_mpg] >= 6, "Medium MPG", "Low MPG")
		dataType: string
		lineageTag: 18facad7-0e7d-5994-9189-03fa7f5fedf0
