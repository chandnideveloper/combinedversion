		lineageTag: 91098b09-6315-5012-8cb4-76e719439999

	/// TODO (Qlik AGGR() has no DAX equivalent): Rebuild with SUMMARIZE/ADDCOLUMNS and an iterator, e.g. MAXX(SUMMARIZE(Table, Table[Key], "v", SUM(Table[Col])), [v]).
